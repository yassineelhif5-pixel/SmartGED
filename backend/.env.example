# Copy to .env and adjust. Never commit the real .env.
DOCUMIND_ENVIRONMENT=dev
DOCUMIND_SECRET_KEY=replace-with-64-random-chars-generated-by-openssl-rand-hex-32
DOCUMIND_DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
# Dedicated schema (Supabase): see supabase/README.md
# DOCUMIND_DB_SCHEMA=smartged
DOCUMIND_REDIS_URL=redis://localhost:6379/0
DOCUMIND_CORS_ORIGINS=http://localhost:5173
DOCUMIND_SECURE_COOKIES=false
DOCUMIND_STORAGE_PROVIDER=local
DOCUMIND_STORAGE_LOCAL_ROOT=./data/storage
DOCUMIND_OCR_PROVIDER=tesseract
DOCUMIND_OCR_LANGUAGES=fra+eng
# DOCUMIND_CLAMAV_HOST=localhost
DOCUMIND_BOOTSTRAP_ADMIN_EMAIL=admin@documind.example.com
DOCUMIND_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Now-2026
# Encryption key for tenant secrets (AI keys). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DOCUMIND_ENCRYPTION_KEY=
# Run Celery tasks inline (no worker needed) — dev only
DOCUMIND_CELERY_EAGER=false
